{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stickler",
  "mainBinaryName": "stickler",
  "version": "0.1.0",
  "identifier": "net.nerdindustries.stickler",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Stickler",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
